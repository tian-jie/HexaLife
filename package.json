{
  "name": "hexalife",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --release",
    "tauri:debug": "tauri dev",
    "tauri:covid": "HEXALIFE_ENV=config/env/1000-mobile.toml HEXALIFE_VIRUS=covid tauri dev --release",
    "tauri:norovirus": "HEXALIFE_ENV=config/env/1000.toml HEXALIFE_VIRUS=norovirus tauri dev --release",
    "tauri:bubonic": "HEXALIFE_ENV=config/env/cities.toml HEXALIFE_VIRUS=bubonic tauri dev --release",
    "tauri:pneumonic": "HEXALIFE_ENV=config/env/cities.toml HEXALIFE_VIRUS=pneumonic tauri dev --release"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
		"vite": "^8.0.16",
    "typescript": "~6.0.3"
  }
}
